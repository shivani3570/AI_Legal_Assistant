
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>AI Legal Assistant - Smart Form Filling</title>

    <link rel="stylesheet"
          href="{{ url_for('smart_form.static', filename='smart_form.css') }}">

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f4f6fb;
            margin: 0;
            padding: 20px;
            color: #222;
        }

        .sf-container {
            max-width: 850px;
            margin: 30px auto;
            background: white;
            padding: 30px;
            border-radius: 14px;
            box-shadow: 0 4px 18px rgba(0,0,0,0.08);
        }

        .sf-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .sf-header h1 {
            color: #253b80;
            margin-bottom: 10px;
        }

        .sf-header p {
            color: #666;
        }

        .sf-language {
            margin-bottom: 25px;
        }

        label {
            display: block;
            font-weight: 600;
            margin-bottom: 8px;
        }

        input, select, textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 7px;
            font-size: 15px;
            box-sizing: border-box;
            margin-bottom: 15px;
        }

        input[type="checkbox"] {
            width: auto;
        }

        button {
            padding: 11px 18px;
            border: none;
            border-radius: 7px;
            cursor: pointer;
            background: #304c9b;
            color: white;
            font-size: 14px;
            margin: 5px;
        }

        button:hover {
            background: #203875;
        }

        button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .sf-secondary {
            background: #687386;
        }

        .sf-success {
            background: #16834a;
        }

        .sf-card {
            border: 1px solid #e0e4ed;
            border-radius: 10px;
            padding: 22px;
            margin-top: 20px;
        }

        .sf-progress-track {
            width: 100%;
            height: 10px;
            background: #e6e9f0;
            border-radius: 10px;
            overflow: hidden;
            margin: 12px 0;
        }

        #sfProgressBar {
            height: 10px;
            width: 0%;
            background: #304c9b;
            transition: width 0.3s;
        }

        #sfProgressPercent {
            font-weight: bold;
        }

        #sfFieldMessage,
        #sfLoadError,
        #sfFinishMessage {
            margin-top: 12px;
            font-weight: 600;
        }

        #sfVoiceStatus {
            color: #304c9b;
            margin-top: 8px;
        }

        .sf-review-item {
            border: 1px solid #e1e4eb;
            padding: 15px;
            margin: 12px 0;
            border-radius: 8px;
        }

        .sf-review-item h4 {
            margin-top: 0;
            color: #253b80;
        }

        .sf-review-item p {
            overflow-wrap: anywhere;
        }

        .sf-button-group {
            margin-top: 20px;
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .sf-note {
            background: #f0f4ff;
            padding: 12px;
            border-radius: 7px;
            color: #34446c;
            font-size: 14px;
        }

        @media (max-width: 600px) {
            .sf-container {
                padding: 18px;
                margin: 10px auto;
            }

            .sf-button-group button {
                flex: 1 1 100%;
            }
        }
    </style>
</head>

<body>

<div class="sf-container">

    <!-- HEADER -->

    <div class="sf-header">
        <h1>AI Legal Assistant</h1>

        <p>
            Regional Voice-Based Smart Form Filling Assistant
        </p>

        <p>
            Fill online forms easily using your preferred language.
        </p>
    </div>


    <!-- LANGUAGE SELECTION -->

    <div class="sf-language">

        <label for="sfLanguage">
            Select Your Language
        </label>

        <select id="sfLanguage">
            <option value="en">English</option>
            <option value="kn">ಕನ್ನಡ (Kannada)</option>
            <option value="hi">हिन्दी (Hindi)</option>
        </select>

    </div>


    <!-- LOAD FORM SECTION -->

    <section id="sfLoadForm" class="sf-card">

        <h2>Load Application Form</h2>

        <p>
            Enter the URL of the online form you want to fill.
        </p>

        <label for="sfFormUrl">
            Form URL
        </label>

        <input
            type="url"
            id="sfFormUrl"
            placeholder="https://example.com/application-form"
        >

        <div class="sf-button-group">

            <button
                type="button"
                id="sfLoadButton">
                Load Form
            </button>

            <button
                type="button"
                id="sfDemoButton"
                class="sf-secondary">
                Try Demo Form
            </button>

        </div>

        <p id="sfLoadError"></p>

        <div class="sf-note">
            For the demo, first start the local demo form server
            using port 8000.
        </div>

    </section>


    <!-- SMART FORM ASSISTANT -->

    <section id="sfAssistant" style="display:none;">

        <div class="sf-card">

            <h2>Smart Form Assistant</h2>

            <p id="sfSummary"></p>

            <button
                type="button"
                id="sfChangeForm"
                class="sf-secondary">
                Change Form
            </button>

        </div>


        <!-- PROGRESS -->

        <div class="sf-card">

            <p id="sfProgressText">
                Question 1
            </p>

            <div class="sf-progress-track">
                <div id="sfProgressBar"></div>
            </div>

            <p id="sfProgressPercent">0%</p>

        </div>


        <!-- QUESTION CARD -->

        <div id="sfQuestionCard" class="sf-card">

            <h2 id="sfQuestionLabel">
                Your question will appear here.
            </h2>

            <p id="sfQuestionHelp"></p>

            <div id="sfAnswerArea"></div>

            <div class="sf-button-group">

                <button
                    type="button"
                    id="sfSpeakAnswer"
                    class="sf-secondary">
                    Speak Answer
                </button>

                <button
                    type="button"
                    id="sfCheck">
                    Check Answer
                </button>

                <button
                    type="button"
                    id="sfBack"
                    class="sf-secondary">
                    Back
                </button>

            </div>

            <p id="sfVoiceStatus"></p>

            <p id="sfFieldMessage"></p>

        </div>


        <!-- CONFIRMATION CARD -->

        <div
            id="sfConfirmBox"
            class="sf-card"
            style="display:none;">

            <h3>Confirm Your Answer</h3>

            <p id="sfConfirmText"></p>

            <p>
                Is this answer correct?
            </p>

            <div class="sf-button-group">

                <button
                    type="button"
                    id="sfEdit"
                    class="sf-secondary">
                    Edit
                </button>

                <button
                    type="button"
                    id="sfConfirm"
                    class="sf-success">
                    Yes, Continue
                </button>

            </div>

        </div>


        <!-- REVIEW SECTION -->

        <div
            id="sfReview"
            class="sf-card"
            style="display:none;">

            <h2>Your Application Review</h2>

            <p>
                Please check all your answers before submitting.
            </p>

            <div id="sfReviewList"></div>

            <div class="sf-button-group">

                <button
                    type="button"
                    id="sfReviewBack"
                    class="sf-secondary">
                    Back
                </button>

                <button
                    type="button"
                    id="sfFinish"
                    class="sf-success">
                    Finish / Submit Application
                </button>

            </div>

            <p id="sfFinishMessage"></p>

        </div>

    </section>

</div>


<!-- JAVASCRIPT -->

<script src="{{ url_for('smart_form.static', filename='smart_form.js') }}"></script>

</body>
</html>
